}

/* ---------- explorer ---------- */
function explorerRender(){
  const search = norm(document.getElementById('explorerSearch').value);
  let rows = STATE.rows;
  if(search) rows = rows.filter(r => STATE.headers.some(h => norm(r[h]).includes(search)));
  if(STATE.explorerSort){
    const {col, dir} = STATE.explorerSort;
    rows = rows.slice().sort((a,b)=>{
      const av = toNumber(a[col]), bv = toNumber(b[col]);
      let cmp;
      if(av!==null && bv!==null) cmp = av-bv; else cmp = String(a[col]).localeCompare(String(b[col]));
      return dir==='asc'?cmp:-cmp;
    });
  }
  const pageSize = 25;
  const maxPage = Math.max(0, Math.ceil(rows.length/pageSize)-1);
  STATE.explorerPage = Math.min(STATE.explorerPage, maxPage);
  const slice = rows.slice(STATE.explorerPage*pageSize, STATE.explorerPage*pageSize+pageSize);
  const head = '<tr>' + STATE.headers.map(h=>{
    const sortIcon = STATE.explorerSort && STATE.explorerSort.col===h ? (STATE.explorerSort.dir==='asc'?' ▲':' ▼') : '';
    return `<th class="sortable" onclick="AD.explorerSortBy('${esc(h).replace(/'/g,"\\'")}')">${esc(h)}${sortIcon}</th>`;
  }).join('') + '</tr>';
  const body = slice.map(r=>'<tr>'+STATE.headers.map(h=>`<td>${esc(String(r[h]!==undefined?r[h]:''))}</td>`).join('')+'</tr>').join('');
  document.getElementById('explorerTbl').innerHTML = `<thead>${head}</thead><tbody>${body}</tbody>`;
  document.getElementById('explorerCount').textContent = `${rows.length.toLocaleString()} matching rows`;
  document.getElementById('pagerLabel').textContent = `Page ${STATE.explorerPage+1} of ${maxPage+1}`;
}
function explorerSortBy(col){
  if(STATE.explorerSort && STATE.explorerSort.col===col) STATE.explorerSort.dir = STATE.explorerSort.dir==='asc'?'desc':'asc';
  else STATE.explorerSort = {col, dir:'desc'};
  explorerRender();
}
function explorerPage(delta){ STATE.explorerPage = Math.max(0, STATE.explorerPage+delta); explorerRender(); }

function renderProfile(){
  const rows = STATE.headers.map(h=>{
    const c = STATE.columns[h];
    let stat = '—';
    if(c.type==='numeric') stat = `min ${fmtNum(c.min)} · max ${fmtNum(c.max)} · avg ${fmtNum(c.avg)}`;
    else if(c.type==='date') stat = c.min && c.max ? `${c.min.toISOString().slice(0,10)} → ${c.max.toISOString().slice(0,10)}` : '—';
    else stat = `${c.unique} unique values`;
    return `<tr><td><b>${esc(h)}</b></td><td style="text-transform:capitalize;">${c.type}</td><td class="num">${(100-c.missingPct).toFixed(1)}%</td><td class="num">${c.unique}</td><td style="font-family:var(--font-data); font-size:12px;">${stat}</td></tr>`;
  }).join('');
  document.getElementById('profileTbl').innerHTML = `<thead><tr><th>Column</th><th>Type</th><th>Non-null %</th><th>Unique values</th><th>Statistics</th></tr></thead><tbody>${rows}</tbody>`;
}

/* ---------- export ---------- */
async function getDownloads(){
  try{ return await claude.use('downloads'); }catch(e){ return null; }
}
async function saveFile(filename, data){
  const dl = await getDownloads();
  if(!dl){ alert('Downloads are not available in this view.'); return false; }
  try{ await dl.save({filename, data}); return true; }
  catch(e){ console.error(e); return false; }
}
function rowsToCSV(rows){
  const head = STATE.headers.map(h=>'"'+String(h).replace(/"/g,'""')+'"').join(',');
  const body = rows.map(r=>STATE.headers.map(h=>'"'+String(r[h]!==undefined?r[h]:'').replace(/"/g,'""')+'"').join(',')).join('\n');
  return head+'\n'+body;
}
async function exportCSV(filteredOnly){
  const statusEl = document.getElementById(filteredOnly?'statusCsvFiltered':'statusCsvFull');
  statusEl.textContent = 'Preparing...'; statusEl.className='export-status';
  const rows = filteredOnly ? getFilteredRows() : STATE.rows;
  const csv = rowsToCSV(rows);
  const ok = await saveFile(`autodash_${filteredOnly?'filtered':'full'}.csv`, new Blob([csv], {type:'text/csv'}));
  statusEl.textContent = ok ? `Saved ${rows.length.toLocaleString()} rows.` : 'Save was cancelled or unavailable.';
  statusEl.className = 'export-status ' + (ok?'ok':'err');
}
async function exportExcel(){
  const statusEl = document.getElementById('statusExcel');
  if(typeof XLSX === 'undefined'){ statusEl.textContent='Excel engine unavailable.'; statusEl.className='export-status err'; return; }
  statusEl.textContent = 'Building workbook...'; statusEl.className='export-status';
  const wb = XLSX.utils.book_new();
  const kpiRows = STATE.kpis.map(k=>({Metric:k.label, Value:k.value, Formula:k.formula, Calculation:k.calc}));
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(kpiRows), 'Dashboard');
  const cleaned = getFilteredRows();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(cleaned), 'Cleaned Data');
  const profileRows = STATE.headers.map(h=>{
    const c = STATE.columns[h];
    return {Column:h, Type:c.type, 'Non-null %': (100-c.missingPct).toFixed(1), Unique: c.unique,
      Min: c.min!==undefined? (c.min instanceof Date? c.min.toISOString().slice(0,10): c.min) : '',
      Max: c.max!==undefined? (c.max instanceof Date? c.max.toISOString().slice(0,10): c.max) : '',
      Avg: c.avg!==undefined ? Math.round(c.avg*100)/100 : ''};
  });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(profileRows), 'Data Profile');
  const h = computeHealth();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet([
    {Metric:'Health score', Value:h.score}, {Metric:'Missing values %', Value:h.missingPct.toFixed(1)},
    {Metric:'Duplicate rows %', Value:h.dupPct.toFixed(1)}, {Metric:'Date consistency %', Value:h.dateCons.toFixed(1)},
    {Metric:'Numeric consistency %', Value:h.numCons.toFixed(1)}, {Metric:'Category consistency %', Value:h.catCons.toFixed(1)}
  ]), 'Data Quality');
  const wbout = XLSX.write(wb, {bookType:'xlsx', type:'array'});
  const ok = await saveFile('autodash_dashboard.xlsx', new Blob([wbout], {type:'application/octet-stream'}));
  statusEl.textContent = ok ? 'Workbook saved.' : 'Save was cancelled or unavailable.';
  statusEl.className = 'export-status ' + (ok?'ok':'err');
}
