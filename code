/* ---------- Ask Your Data engine ---------- */
function pushChat(role, html){
  const log = document.getElementById('chatLog');
  const div = document.createElement('div');
  div.className = 'chat-msg ' + role;
  div.innerHTML = html;
  log.appendChild(div);
  log.scrollTop = log.scrollHeight;
}
function findMetricCol(ql){
  const numCols = STATE.headers.filter(h=>STATE.columns[h].type==='numeric');
  for(const h of numCols){ if(ql.includes(norm(h))) return h; }
  for(const role of ['sales','target','quantity','cost','price']){
    for(const syn of ROLE_SYNONYMS[role]){ if(ql.includes(syn)){ const c = primaryCol(role); if(c) return c; } }
  }
  return dashboardMetricCol();
}
function findCategoryColFromQuestion(ql){
  for(const role of ['region','product','salesperson','distributor']){
    for(const syn of ROLE_SYNONYMS[role]){
      if(ql.includes(syn)){ const c = primaryCol(role); if(c) return c; }
    }
  }
  // try matching a specific value
  for(const col of categoryCols()){
    const vals = STATE.columns[col].uniqueValues || [];
    for(const v of vals){ if(v && ql.includes(norm(v))) return col; }
  }
  return null;
}
function findValueMatch(ql){
  for(const col of categoryCols()){
    const vals = STATE.columns[col].uniqueValues || [];
    for(const v of vals){
      const nv = norm(v);
      if(nv.length>1 && new RegExp('\\b'+nv.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\b').test(ql)) return {col, val:v};
    }
  }
  return null;
}
function answerQuestion(q){
  const ql = norm(q);
  const metricCol = findMetricCol(ql);
  if(!metricCol){
    return {text:`I can't find a numeric column in this dataset that matches what you're asking about. Available numeric fields: ${STATE.headers.filter(h=>STATE.columns[h].type==='numeric').join(', ') || 'none'}.`, calc:null};
  }
  const rows = getFilteredRows();

  // top N
  let m = ql.match(/top\s+(\d+)/);
  if(m){
    const n = parseInt(m[1],10);
    const catCol = findCategoryColFromQuestion(ql) || (dashboardCategoryCol()||{}).col;
    if(!catCol) return {text:`I can see ${metricCol}, but there's no category column to rank by.`, calc:null};
    const map = groupSum(rows, catCol, metricCol);
    const sorted = Object.entries(map).sort((a,b)=>b[1]-a[1]).slice(0,n);
    const list = sorted.map((x,i)=>`${i+1}. ${x[0]} — ₹${fmtFull(x[1])}`).join('<br>');
    return {text:`Top ${sorted.length} ${catCol} by ${metricCol}:<br>${list}`,
      calc:`GROUP BY ${catCol}, SUM(${metricCol}), ORDER BY total DESC, LIMIT ${n}`, rowsUsed: rows.length};
  }

  // highest / lowest by category
  if(/highest|most|maximum|best|top\b/.test(ql) && /which|what/.test(ql)){
    const catCol = findCategoryColFromQuestion(ql) || (dashboardCategoryCol()||{}).col;
    if(!catCol) return {text:`I can see ${metricCol}, but there's no category column to compare by.`, calc:null};
    const map = groupSum(rows, catCol, metricCol);
    const sorted = Object.entries(map).sort((a,b)=>b[1]-a[1]);
    if(!sorted.length) return {text:'No matching rows for that question.', calc:null};
    const [name, val] = sorted[0];
    return {text:`${esc(name)} — ₹${fmtFull(val)}`, calc:`SUM(${metricCol}) grouped by ${catCol}, highest value selected.`, rowsUsed: rows.length};
  }
  if(/lowest|least|minimum|worst/.test(ql) && /which|what/.test(ql)){
    const catCol = findCategoryColFromQuestion(ql) || (dashboardCategoryCol()||{}).col;
    if(!catCol) return {text:`I can see ${metricCol}, but there's no category column to compare by.`, calc:null};
    const map = groupSum(rows, catCol, metricCol);
    const sorted = Object.entries(map).sort((a,b)=>a[1]-b[1]);
    if(!sorted.length) return {text:'No matching rows for that question.', calc:null};
    const [name, val] = sorted[0];
    return {text:`${esc(name)} — ₹${fmtFull(val)}`, calc:`SUM(${metricCol}) grouped by ${catCol}, lowest value selected.`, rowsUsed: rows.length};
  }

  // compare A vs B
  m = ql.match(/compare\s+(.+?)\s+(?:vs\.?|versus|and)\s+(.+)/);
  if(m){
    const catCol = findCategoryColFromQuestion(ql) || categoryCols()[0];
    if(!catCol) return {text:`I don't have a category column to compare on.`, calc:null};
    const map = groupSum(rows, catCol, metricCol);
    const names = Object.keys(map);
    const find = (t)=> names.find(n=> norm(t).includes(norm(n)) || norm(n).includes(norm(t.trim())));
    const a = find(m[1]), b = find(m[2]);
    if(!a || !b) return {text:`I couldn't match both values to a ${catCol}. Available values include: ${names.slice(0,8).join(', ')}.`, calc:null};
    return {text:`${a}: ₹${fmtFull(map[a])}<br>${b}: ₹${fmtFull(map[b])}`, calc:`SUM(${metricCol}) WHERE ${catCol} = "${a}" and "${b}"`, rowsUsed: rows.length};
  }

  // growth / change
  if(/growth|change|trend/.test(ql)){
    const dateCol = primaryCol('date');
    if(!dateCol) return {text:`This dataset has no date column, so I can't calculate growth.`, calc:null};
    const sorted = rows.map(r=>({d:toDate(r[dateCol]), v:toNumber(r[metricCol])||0})).filter(x=>x.d).sort((a,b)=>a.d-b.d);
    if(sorted.length<4) return {text:`Not enough dated rows to calculate growth.`, calc:null};
    const mid = Math.floor(sorted.length/2);
    const first = sorted.slice(0,mid).reduce((a,x)=>a+x.v,0);
    const second = sorted.slice(mid).reduce((a,x)=>a+x.v,0);
    const growth = first ? ((second-first)/first*100) : null;
    return {text: growth!==null ? `${growth>=0?'+':''}${growth.toFixed(1)}%` : 'Could not calculate — first-half total is zero.',
      calc:`(2nd-half ${metricCol} − 1st-half ${metricCol}) ÷ 1st-half × 100 = (₹${fmtFull(second)}-₹${fmtFull(first)}) ÷ ₹${fmtFull(first)} × 100`, rowsUsed: rows.length};
  }

  // average
  if(/average|avg|mean/.test(ql)){
    const vm = findValueMatch(ql);
    let use = rows; let scope = `across all ${rows.length.toLocaleString()} rows`;
    if(vm){ use = rows.filter(r=>String(r[vm.col]).trim()===vm.val); scope = `where ${vm.col} = "${vm.val}" (${use.length.toLocaleString()} rows)`; }
    const vals = use.map(r=>toNumber(r[metricCol])).filter(v=>v!==null);
    const avg = vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : null;
    return {text: avg!==null ? '₹'+fmtFull(avg) : 'No valid values found.', calc:`AVERAGE(${metricCol}) ${scope}`, rowsUsed: use.length};
  }

  // default: total / sum, possibly filtered by a mentioned value
  const vm = findValueMatch(ql);
  let use = rows; let scope = `across all ${rows.length.toLocaleString()} rows`;
  if(vm){ use = rows.filter(r=>String(r[vm.col]).trim()===vm.val); scope = `where ${vm.col} = "${vm.val}" (${use.length.toLocaleString()} rows)`; }
  const total = use.reduce((a,r)=>a+(toNumber(r[metricCol])||0),0);
  return {text:'₹'+fmtFull(total), calc:`SUM(${metricCol}) ${scope}`, rowsUsed: use.length};
}
function askSubmit(){
  const input = document.getElementById('chatInput');
  const q = input.value.trim(); if(!q) return;
  pushChat('user', esc(q));
  input.value = '';
  setTimeout(()=>{
    const res = answerQuestion(q);
    let html = `<div class="ans">${res.text}</div>`;
    if(res.calc) html += `<div class="calc-box">Calculation: ${esc(res.calc)}${res.rowsUsed!==undefined?`<br>Rows used: ${res.rowsUsed.toLocaleString()}`:''}</div>`;
    pushChat('bot', html);
  }, 150);
}
function renderAskSuggestions(){
  const metricCol = dashboardMetricCol();
  const catInfo = dashboardCategoryCol();
