function buildKPIs(rows){
  const metricCol = dashboardMetricCol();
  const targetCol = primaryCol('target');
  const qtyCol = primaryCol('quantity');
  const dateCol = STATE.filters.dateCol;
  const catInfo = dashboardCategoryCol();
  const kpis = [];
  if(metricCol){
    const total = rows.reduce((a,r)=>a+(toNumber(r[metricCol])||0),0);
    kpis.push({label:'Total '+metricCol, value:'₹'+fmtNum(total), raw:total,
      formula:`SUM(${metricCol})`, calc:`Added ${metricCol} across ${rows.length.toLocaleString()} rows = ₹${fmtFull(total)}`});
    if(targetCol){
      const tgt = rows.reduce((a,r)=>a+(toNumber(r[targetCol])||0),0);
      const ach = tgt ? (total/tgt*100) : null;
      kpis.push({label:'Target', value:'₹'+fmtNum(tgt), raw:tgt, formula:`SUM(${targetCol})`, calc:`Added ${targetCol} across ${rows.length.toLocaleString()} rows = ₹${fmtFull(tgt)}`});
      kpis.push({label:'Achievement', value: ach!==null ? ach.toFixed(1)+'%' : '—', raw:ach,
        formula:`${metricCol} ÷ ${targetCol} × 100`, calc: ach!==null ? `₹${fmtFull(total)} ÷ ₹${fmtFull(tgt)} × 100 = ${ach.toFixed(1)}%` : 'Target is zero for this selection.'});
    }
    if(dateCol){
      const sorted = rows.map(r=>({d:toDate(r[dateCol]), v:toNumber(r[metricCol])||0})).filter(x=>x.d).sort((a,b)=>a.d-b.d);
      if(sorted.length>4){
        const mid = Math.floor(sorted.length/2);
        const first = sorted.slice(0,mid).reduce((a,x)=>a+x.v,0);
        const second = sorted.slice(mid).reduce((a,x)=>a+x.v,0);
        const growth = first ? ((second-first)/first*100) : null;
        kpis.push({label:'Growth (1st half → 2nd half)', value: growth!==null ? (growth>=0?'+':'')+growth.toFixed(1)+'%' : '—', raw:growth,
          delta: growth, formula:`(2nd-half ${metricCol} − 1st-half ${metricCol}) ÷ 1st-half × 100`,
          calc: growth!==null ? `(₹${fmtFull(second)} − ₹${fmtFull(first)}) ÷ ₹${fmtFull(first)} × 100 = ${growth.toFixed(1)}%` : 'Not enough data to compute.'});
      }
    }
  }
  if(qtyCol && qtyCol !== metricCol){
    const q = rows.reduce((a,r)=>a+(toNumber(r[qtyCol])||0),0);
    kpis.push({label:'Total '+qtyCol, value:fmtNum(q), raw:q, formula:`SUM(${qtyCol})`, calc:`Added ${qtyCol} across ${rows.length.toLocaleString()} rows = ${fmtFull(q)}`});
  }
  if(catInfo){
    const uniq = new Set(rows.map(r=>String(r[catInfo.col]).trim())).size;
    kpis.push({label:'Active '+catInfo.col, value:fmtFull(uniq), raw:uniq, formula:`COUNT(DISTINCT ${catInfo.col})`, calc:`${uniq} distinct values of ${catInfo.col} appear in these ${rows.length.toLocaleString()} rows.`});
  }
  kpis.push({label:'Records', value:fmtFull(rows.length), raw:rows.length, formula:'COUNT(rows)', calc:`${rows.length.toLocaleString()} rows match the current filters.`});
  return kpis;
}

