<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>AutoDash AI — Upload your data. Get your dashboard.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
/* ============ TOKENS ============ */
:root{
  --ink:#12213C;
  --paper:#EEF0EA;
  --paper-alt:#E3E6DE;
  --card:#FFFFFF;
  --line:rgba(18,33,60,.14);
  --line-strong:rgba(18,33,60,.26);
  --text-dim:rgba(18,33,60,.62);
  --accent:#156B62;
  --accent-ink:#ffffff;
  --accent-2:#B9811F;
  --pos:#1F7A4C;
  --neg:#B23B2E;
  --radius:14px;
  --radius-sm:8px;
  --shadow:0 1px 2px rgba(18,33,60,.06), 0 10px 28px -14px rgba(18,33,60,.22);
  --font-display:'Space Grotesk', 'Arial Narrow', Arial, sans-serif;
  --font-body:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-data:'IBM Plex Mono', 'SF Mono', Consolas, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]):not([data-theme="executive"]){
    --ink:#ECEEE8; --paper:#0D131E; --paper-alt:#121A27; --card:#141C2A;
    --line:rgba(236,238,232,.14); --line-strong:rgba(236,238,232,.26);
    --text-dim:rgba(236,238,232,.6); --accent:#2FB7A6; --accent-ink:#06130F;
    --accent-2:#E0A94B; --pos:#3FBE7C; --neg:#E2695B; color-scheme: dark;
  }
}
[data-theme="dark"]{
  --ink:#ECEEE8; --paper:#0D131E; --paper-alt:#121A27; --card:#141C2A;
  --line:rgba(236,238,232,.14); --line-strong:rgba(236,238,232,.26);
  --text-dim:rgba(236,238,232,.6); --accent:#2FB7A6; --accent-ink:#06130F;
  --accent-2:#E0A94B; --pos:#3FBE7C; --neg:#E2695B; color-scheme: dark;
}
[data-theme="executive"]{
  --ink:#1A1A18; --paper:#F4F2EC; --paper-alt:#E9E5D9; --card:#FFFFFF;
  --line:rgba(26,26,24,.16); --line-strong:rgba(26,26,24,.3);
  --text-dim:rgba(26,26,24,.6); --accent:#0F2F4D; --accent-ink:#ffffff;
  --accent-2:#8C6A2F; --pos:#1F6B3F; --neg:#9C3A2C; color-scheme: light;
}
*{box-sizing:border-box;}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
body{
  margin:0; background:var(--paper); color:var(--ink);
  font-family:var(--font-body); font-size:15px; line-height:1.55;
  -webkit-font-smoothing:antialiased;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  transition:background .25s ease, color .25s ease;
}
h1,h2,h3,h4{font-family:var(--font-display); margin:0; letter-spacing:-.01em;}
p{margin:0;}
a{color:inherit;}
.num{font-family:var(--font-data); font-variant-numeric:tabular-nums;}
button{font-family:inherit; cursor:pointer;}
::selection{background:var(--accent); color:var(--accent-ink);}
:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}
.wrap{max-width:1180px; margin:0 auto; padding:0 28px;}
@media(max-width:720px){.wrap{padding:0 18px;}}

/* ============ NAV ============ */
#topnav{
  position:sticky; top:0; z-index:40; background:color-mix(in srgb, var(--paper) 88%, transparent);
  backdrop-filter:blur(10px); border-bottom:1px solid var(--line);
  padding-top:env(safe-area-inset-top,0px);
}
.nav-inner{display:flex; align-items:center; justify-content:space-between; height:66px;}
.brand{display:flex; align-items:center; gap:9px; font-family:var(--font-display); font-weight:600; font-size:18px;}
.brand .mark{width:26px;height:26px;border-radius:7px;background:var(--accent);display:flex;align-items:center;justify-content:center;}
.brand .mark svg{width:15px;height:15px;}
.nav-links{display:flex; gap:28px; align-items:center;}
.nav-links a{font-size:14px; color:var(--text-dim); text-decoration:none;}
.nav-links a:hover{color:var(--ink);}
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:11px 20px; border-radius:999px; border:1px solid var(--line-strong);
  background:transparent; color:var(--ink); font-size:14px; font-weight:500; white-space:nowrap;
  transition:transform .15s ease, border-color .15s ease, background .15s ease;
}
.btn:hover{border-color:var(--ink); transform:translateY(-1px);}
.btn-primary{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}
.btn-primary:hover{filter:brightness(1.08); border-color:var(--accent);}
.btn-sm{padding:7px 14px; font-size:13px; border-radius:8px;}
.btn-ghost{border-color:transparent;}
.btn-ghost:hover{border-color:var(--line-strong);}
.btn:disabled{opacity:.45; pointer-events:none;}
@media(max-width:860px){.nav-links{display:none;}}

/* ============ LANDING ============ */
.eyebrow{font-size:13px; color:var(--accent-2); font-weight:600;}
.hero{padding:84px 0 56px;}
.hero-grid{display:grid; grid-template-columns:1.05fr .95fr; gap:56px; align-items:center;}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr; gap:40px;}}
.hero h1{font-size:clamp(34px,5vw,58px); line-height:1.04; font-weight:600; max-width:620px;}
.hero p.sub{margin-top:20px; font-size:18px; color:var(--text-dim); max-width:520px; line-height:1.6;}
.hero-cta{display:flex; gap:12px; margin-top:32px; flex-wrap:wrap;}

.flow-card{
  background:var(--card); border:1px solid var(--line); border-radius:18px; padding:26px;
  box-shadow:var(--shadow);
}
.flow-step{
  display:flex; align-items:center; gap:14px; padding:14px 4px; opacity:.35; transform:translateX(-6px);
  transition:opacity .5s ease, transform .5s ease;
}
.flow-step.on{opacity:1; transform:translateX(0);}
.flow-step .dot{
  width:34px;height:34px;border-radius:9px;background:var(--paper-alt);border:1px solid var(--line);
  display:flex;align-items:center;justify-content:center; font-family:var(--font-data); font-size:13px; flex-shrink:0;
}
.flow-step.on .dot{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}
.flow-step .lbl{font-weight:500; font-size:15px;}
.flow-step .sub{font-size:12.5px; color:var(--text-dim); margin-top:2px;}
.flow-line{width:1px; height:16px; background:var(--line); margin-left:21px;}

.strip{padding:50px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
.strip-row{display:flex; gap:0; justify-content:space-between; flex-wrap:wrap;}
.strip-item{flex:1; min-width:150px; padding:0 18px; text-align:center;}
.strip-item .n{font-family:var(--font-data); font-size:28px; font-weight:600; color:var(--accent);}
.strip-item .t{font-size:13px; color:var(--text-dim); margin-top:4px;}

.section{padding:76px 0;}
.section-head{max-width:560px; margin-bottom:40px;}
.section-head h2{font-size:clamp(26px,3.4vw,36px); font-weight:600;}
.section-head p{margin-top:12px; color:var(--text-dim); font-size:16px; line-height:1.6;}

.grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
@media(max-width:860px){.grid-3{grid-template-columns:1fr 1fr;}}
@media(max-width:600px){.grid-3{grid-template-columns:1fr;}}
.feat{border:1px solid var(--line); border-radius:var(--radius); padding:24px; background:var(--card);}
.feat .ic{width:36px;height:36px;border-radius:9px;background:var(--paper-alt);display:flex;align-items:center;justify-content:center; margin-bottom:16px;}
.feat h3{font-size:16px; font-weight:600; margin-bottom:8px;}
.feat p{font-size:14px; color:var(--text-dim); line-height:1.55;}

.industries{display:flex; gap:10px; flex-wrap:wrap; margin-top:28px;}
.ind-chip{border:1px solid var(--line); border-radius:999px; padding:8px 16px; font-size:13.5px; color:var(--text-dim);}

.trust{display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center;}
@media(max-width:800px){.trust{grid-template-columns:1fr;}}
.trust-list{display:flex; flex-direction:column; gap:14px; margin-top:18px;}
.trust-list .row{display:flex; gap:12px; align-items:flex-start; font-size:14.5px;}
.trust-list .row .chk{color:var(--accent); font-family:var(--font-data); flex-shrink:0;}

.cta-band{background:var(--ink); color:var(--paper); border-radius:20px; padding:56px 44px; display:flex; justify-content:space-between; align-items:center; gap:24px; flex-wrap:wrap;}
[data-theme="dark"] .cta-band{background:var(--paper-alt); color:var(--ink); border:1px solid var(--line-strong);}
.cta-band h2{font-size:28px; color:inherit;}
.cta-band .btn-primary{background:var(--paper); color:var(--ink); border-color:var(--paper);}
[data-theme="dark"] .cta-band .btn-primary{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}

footer{border-top:1px solid var(--line); padding:36px 0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;}
footer .fsub{font-size:13px; color:var(--text-dim);}
.theme-switch{display:flex; gap:6px; border:1px solid var(--line); border-radius:999px; padding:3px;}
.theme-switch button{border:none; background:transparent; padding:6px 12px; border-radius:999px; font-size:12.5px; color:var(--text-dim);}
.theme-switch button.active{background:var(--ink); color:var(--paper);}

/* ============ APP SHELL ============ */
#appview{display:none; min-height:calc(100vh - 66px);}
#appview.on{display:block;}
#landing.off{display:none;}
.steps-rail{
  display:flex; gap:4px; padding:16px 0; overflow-x:auto; border-bottom:1px solid var(--line);
}
.step-pill{
  display:flex; align-items:center; gap:8px; padding:8px 14px; border-radius:999px; font-size:13px;
  color:var(--text-dim); white-space:nowrap; border:1px solid transparent; flex-shrink:0;
}
.step-pill .d{width:18px;height:18px;border-radius:50%;background:var(--paper-alt);display:flex;align-items:center;justify-content:center;font-family:var(--font-data);font-size:10px;}
.step-pill.active{color:var(--ink); border-color:var(--line); background:var(--card); font-weight:500;}
.step-pill.active .d{background:var(--accent); color:var(--accent-ink);}
.step-pill.done .d{background:var(--pos); color:#fff;}

.app-main{padding:34px 0 80px;}
.panel{display:none;}
.panel.on{display:block;}

/* upload */
.upload-zone{
  border:2px dashed var(--line-strong); border-radius:20px; padding:64px 32px; text-align:center;
  background:var(--card); transition:border-color .15s ease, background .15s ease;
}
.upload-zone.drag{border-color:var(--accent); background:color-mix(in srgb, var(--accent) 8%, var(--card));}
.upload-zone h3{font-size:20px; margin-bottom:8px;}
.upload-zone p{color:var(--text-dim); font-size:14px;}
.upload-icon{width:52px;height:52px;border-radius:14px;background:var(--paper-alt);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;}
#fileInput{display:none;}
.filetypes{margin-top:18px; display:flex; gap:8px; justify-content:center; flex-wrap:wrap;}
.filetypes span{font-family:var(--font-data); font-size:11.5px; border:1px solid var(--line); border-radius:6px; padding:3px 8px; color:var(--text-dim);}
.err-box{margin-top:18px; border:1px solid var(--neg); background:color-mix(in srgb, var(--neg) 10%, var(--card)); color:var(--neg); border-radius:10px; padding:14px 16px; font-size:13.5px; text-align:left;}

.file-summary{display:flex; align-items:center; gap:16px; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:18px 22px; margin-top:20px; flex-wrap:wrap;}
.file-summary .fname{font-weight:600; font-family:var(--font-data); font-size:14px;}
.file-summary .meta{display:flex; gap:18px; flex-wrap:wrap; font-size:13px; color:var(--text-dim);}
.file-summary .meta b{color:var(--ink); font-family:var(--font-data);}

/* inspect */
.health-card{display:grid; grid-template-columns:200px 1fr; gap:28px; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:26px; align-items:center;}
@media(max-width:700px){.health-card{grid-template-columns:1fr;}}
.health-ring{position:relative; width:150px; height:150px; margin:0 auto;}
.health-ring svg{transform:rotate(-90deg);}
.health-ring .score{position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;}
.health-ring .score .n{font-family:var(--font-data); font-size:34px; font-weight:600;}
.health-ring .score .l{font-size:11px; color:var(--text-dim);}
.health-metrics{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
.hm-row{display:flex; justify-content:space-between; font-size:13.5px; border-bottom:1px dashed var(--line); padding-bottom:8px;}
.hm-row b{font-family:var(--font-data);}

.card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px;}
.card + .card{margin-top:18px;}
.card h3{font-size:15px; font-weight:600; margin-bottom:14px; display:flex; align-items:center; justify-content:space-between;}

table.data-tbl{width:100%; border-collapse:collapse; font-size:13px;}
table.data-tbl th{text-align:left; font-weight:600; font-size:11.5px; text-transform:none; color:var(--text-dim); border-bottom:1px solid var(--line-strong); padding:8px 10px; white-space:nowrap;}
table.data-tbl td{padding:8px 10px; border-bottom:1px solid var(--line); white-space:nowrap;}
table.data-tbl tbody tr:hover{background:var(--paper-alt);}
.tbl-scroll{overflow-x:auto;}
.badge{font-size:10.5px; padding:2px 7px; border-radius:5px; font-family:var(--font-data);}
.badge.high{background:color-mix(in srgb, var(--pos) 16%, transparent); color:var(--pos);}
.badge.medium{background:color-mix(in srgb, var(--accent-2) 20%, transparent); color:var(--accent-2);}
.badge.low{background:color-mix(in srgb, var(--neg) 14%, transparent); color:var(--neg);}
select.role-select{font-size:12px; padding:4px 6px; border-radius:6px; border:1px solid var(--line-strong); background:var(--card); color:var(--ink); font-family:var(--font-body);}

/* industry */
.industry-card{display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;}
.ind-main{display:flex; align-items:center; gap:16px;}
.ind-main .ic{width:48px;height:48px;border-radius:12px;background:var(--paper-alt);display:flex;align-items:center;justify-content:center; font-size:22px;}
.conf-bar{width:100%; height:6px; border-radius:99px; background:var(--paper-alt); overflow:hidden; margin-top:8px;}
.conf-bar i{display:block; height:100%; background:var(--accent);}
.reason{font-size:13px; color:var(--text-dim); margin-top:10px; line-height:1.5;}

/* dashboard */
.db-header{display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap; margin-bottom:18px;}
.filters-row{display:flex; gap:10px; flex-wrap:wrap; background:var(--card); border:1px solid var(--line); border-radius:12px; padding:12px 14px; margin-bottom:20px;}
.filter-f{display:flex; flex-direction:column; gap:4px;}
.filter-f label{font-size:11px; color:var(--text-dim);}
.filter-f select, .filter-f input{font-size:13px; padding:6px 8px; border-radius:7px; border:1px solid var(--line-strong); background:var(--paper); color:var(--ink); font-family:var(--font-body);}

.kpi-row{display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:14px; margin-bottom:20px;}
.kpi{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; position:relative;}
.kpi .l{font-size:12.5px; color:var(--text-dim);}
.kpi .v{font-family:var(--font-data); font-size:25px; font-weight:600; margin-top:6px;}
.kpi .d{font-size:12px; margin-top:6px; font-family:var(--font-data);}
.kpi .d.pos{color:var(--pos);} .kpi .d.neg{color:var(--neg);}
.kpi .explain-btn{position:absolute; top:14px; right:14px; font-size:10.5px; color:var(--text-dim); border:1px solid var(--line); border-radius:6px; padding:2px 7px; background:transparent;}
.kpi .explain-btn:hover{border-color:var(--accent); color:var(--accent);}
.kpi .explain{display:none; margin-top:10px; padding-top:10px; border-top:1px dashed var(--line); font-size:11.5px; font-family:var(--font-data); color:var(--text-dim); line-height:1.6;}
.kpi .explain.on{display:block;}

.charts-grid{display:grid; grid-template-columns:1.4fr 1fr; gap:18px; margin-bottom:18px;}
@media(max-width:860px){.charts-grid{grid-template-columns:1fr;}}
.chart-wrap{position:relative; height:260px;}
.chart-card h3{margin-bottom:4px;}
.chart-sub{font-size:12px; color:var(--text-dim); margin-bottom:14px;}
.png-btn{font-size:11px;}

.insight{display:flex; gap:10px; padding:11px 0; border-bottom:1px dashed var(--line); align-items:flex-start;}
.insight:last-child{border-bottom:none;}
.insight .tag{font-size:16px; flex-shrink:0; margin-top:1px;}
.insight .txt{font-size:13.5px; line-height:1.5;}
.insight .calc{font-size:11px; color:var(--text-dim); font-family:var(--font-data); margin-top:3px; display:none;}
.insight .calc.on{display:block;}
.insight .vcalc{font-size:11px; color:var(--accent); background:none; border:none; padding:0; margin-top:3px; font-family:var(--font-body); text-decoration:underline;}

/* ask data */
.chat-shell{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); display:flex; flex-direction:column; height:520px;}
.chat-log{flex:1; overflow-y:auto; padding:20px; display:flex; flex-direction:column; gap:16px;}
.chat-msg{max-width:84%; font-size:13.5px; line-height:1.55;}
.chat-msg.user{align-self:flex-end; background:var(--accent); color:var(--accent-ink); border-radius:12px 12px 2px 12px; padding:10px 14px;}
.chat-msg.bot{align-self:flex-start; background:var(--paper-alt); border-radius:12px 12px 12px 2px; padding:12px 14px;}
.chat-msg.bot .ans{font-family:var(--font-data); font-weight:600; font-size:16px; margin-bottom:6px;}
.chat-msg.bot .calc-box{margin-top:8px; padding-top:8px; border-top:1px dashed var(--line); font-size:11px; font-family:var(--font-data); color:var(--text-dim); line-height:1.7;}
.chat-suggest{display:flex; gap:8px; flex-wrap:wrap; padding:0 20px 14px;}
.chip-sug{font-size:12px; border:1px solid var(--line); border-radius:999px; padding:6px 12px; color:var(--text-dim); background:transparent;}
.chip-sug:hover{border-color:var(--accent); color:var(--accent);}
.chat-input-row{display:flex; gap:10px; padding:14px; border-top:1px solid var(--line);}
.chat-input-row input{flex:1; border:1px solid var(--line-strong); border-radius:10px; padding:11px 14px; background:var(--paper); color:var(--ink); font-size:14px; font-family:inherit;}

/* explorer */
.explorer-toolbar{display:flex; gap:12px; margin-bottom:14px; flex-wrap:wrap; align-items:center; justify-content:space-between;}
.explorer-toolbar input{border:1px solid var(--line-strong); border-radius:9px; padding:9px 12px; background:var(--card); color:var(--ink); font-size:13.5px; min-width:220px;}
.pager{display:flex; align-items:center; gap:10px; font-size:13px; color:var(--text-dim); margin-top:14px; justify-content:flex-end;}
th.sortable{cursor:pointer; user-select:none;}
th.sortable:hover{color:var(--ink);}

/* export */
.export-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:16px;}
.export-card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px;}
.export-card h3{font-size:15px; margin-bottom:6px;}
.export-card p{font-size:13px; color:var(--text-dim); margin-bottom:16px; line-height:1.5;}
.export-status{font-size:12px; margin-top:10px; color:var(--text-dim);}
.export-status.ok{color:var(--pos);} .export-status.err{color:var(--neg);}

.side-nav{position:sticky; top:118px;}
.app-grid{display:grid; grid-template-columns:200px 1fr; gap:32px; align-items:start;}
@media(max-width:900px){.app-grid{grid-template-columns:1fr;} .side-nav{display:none;}}
.side-nav a{display:block; font-size:13.5px; color:var(--text-dim); padding:9px 0; text-decoration:none; border-left:2px solid transparent; padding-left:12px;}
.side-nav a.active{color:var(--ink); font-weight:500; border-left-color:var(--accent);}

.hint-box{border:1px solid var(--line); border-radius:10px; padding:14px 16px; background:var(--paper-alt); font-size:12.5px; color:var(--text-dim); line-height:1.6; margin-bottom:18px;}
.scope-note{font-size:12px; color:var(--text-dim); margin-top:4px;}

@media print{
