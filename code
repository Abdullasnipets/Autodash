function renderInsights(rows, metricCol, catInfo, dateCol){
  const items = [];
  if(metricCol && catInfo){
    const map = groupSum(rows, catInfo.col, metricCol);
    const sorted = Object.entries(map).sort((a,b)=>b[1]-a[1]);
    if(sorted.length){
      const [name, val] = sorted[0];
      const total = sorted.reduce((a,x)=>a+x[1],0);
      const share = total ? (val/total*100) : 0;
      items.push({tag:'📌', txt:`${esc(name)} contributed ${share.toFixed(1)}% of total ${metricCol} — the highest of any ${catInfo.col}.`,
        calc:`SUM(${metricCol}) WHERE ${catInfo.col} = "${name}" → ₹${fmtFull(val)}  |  Total ₹${fmtFull(total)}  |  ${val.toFixed ? '' : ''}Share = ₹${fmtFull(val)} ÷ ₹${fmtFull(total)} × 100 = ${share.toFixed(1)}%`});
    }
    const targetCol = primaryCol('target');
    if(targetCol){
      const tmap = groupSum(rows, catInfo.col, targetCol);
      const below = Object.keys(map).filter(k => tmap[k] && (map[k]/tmap[k]*100) < 70);
      if(below.length){
        items.push({tag:'⚠️', txt:`${below.length} ${catInfo.col}${below.length===1?' is':'s are'} below 70% target achievement: ${below.slice(0,5).map(esc).join(', ')}${below.length>5?'…':''}.`,
          calc:`Achievement = ${metricCol} ÷ ${targetCol} × 100, computed per ${catInfo.col}, filtered to < 70%.`});
      }
    }
  }
  if(metricCol && dateCol){
    const map = {};
    rows.forEach(r=>{ const d=toDate(r[dateCol]); if(!d) return; const key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'); map[key]=(map[key]||0)+(toNumber(r[metricCol])||0); });
    const keys = Object.keys(map).sort();
    if(keys.length>=2){
      const prev = map[keys[keys.length-2]], cur = map[keys[keys.length-1]];
      const chg = prev ? ((cur-prev)/prev*100) : null;
      if(chg !== null && Math.abs(chg) >= 25){
        items.push({tag:'🔔', txt:`${metricCol} in ${keys[keys.length-1]} was ${Math.abs(chg).toFixed(1)}% ${chg<0?'lower':'higher'} than ${keys[keys.length-2]}.`,
          calc:`Previous: ₹${fmtFull(prev)}  Current: ₹${fmtFull(cur)}  Change: (${fmtFull(cur)}-${fmtFull(prev)}) ÷ ${fmtFull(prev)} × 100 = ${chg.toFixed(1)}%`});
      }
    }
  }
  const h = computeHealth();
  if(h.missingPct > 5) items.push({tag:'🩺', txt:`${h.missingPct.toFixed(1)}% of cells in this dataset are missing — some KPIs may undercount.`, calc:`Missing cells ÷ total cells × 100, counted across all ${STATE.headers.length} columns.`});
  if(!items.length) items.push({tag:'ℹ️', txt:'No notable patterns were found in the current selection.', calc:''});
  document.getElementById('insightsBox').innerHTML = items.map((it,i)=>`
    <div class="insight">
      <div class="tag">${it.tag}</div>
      <div><div class="txt">${it.txt}</div>${it.calc?`<button class="vcalc" onclick="AD.toggleCalc(${i})">View calculation</button><div class="calc" id="icalc${i}">${esc(it.calc)}</div>`:''}</div>
    </div>`).join('');
}
