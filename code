<script>
/* ===================================================================
   AUTODASH AI — client-side analysis engine
   Everything below runs in the browser. No server, no LLM call:
   the "Ask Your Data" feature is a deterministic rule-based parser,
   not a language model — every number it returns is a real
   calculation over the parsed rows, shown with its formula.
=================================================================== */
const AD = (function(){

const STATE = {
  rows:[], headers:[], columns:{}, roleOverrides:{}, industry:null,
  filters:{}, fileMeta:{}, explorerPage:0, explorerSort:null, charts:{},
  kpis:[], insights:[], demo:false
};

const STEPS = ['upload','inspect','industry','dashboard','ask','explore','export'];
const STEP_LABELS = {upload:'Upload',inspect:'Inspect',industry:'Industry',dashboard:'Dashboard',ask:'Ask data',explore:'Explore',export:'Export'};
let currentStep = 'upload';

/* ---------- semantic dictionary ---------- */
const ROLE_SYNONYMS = {
  date:['date','month','period','day','mth','transaction date','bill date','order date'],
  sales:['sales','revenue','amount','net amt','net sales','ach','achievement','turnover','value','gmv'],
  target:['target','tgt','goal','budget'],
  quantity:['qty','quantity','units','volume','nos','no. of'],
  product:['sku','product','item','brand','model','variant'],
  salesperson:['asm','executive','rep','salesman','agent','manager','employee','tse','so '],
  distributor:['distributor','dealer','retailer','party','customer','client','account','vendor'],
  region:['region','state','city','zone','territory','area','location','branch','district'],
  cost:['cost','expense','cogs'],
  stock:['stock','inventory','opening','closing'],
  order:['order','invoice','bill no','transaction id','order id'],
  price:['price','rate','unit price','mrp']
};
const ROLE_LABELS = {date:'Date / Period',sales:'Sales / Revenue',target:'Target',quantity:'Quantity',product:'Product',
  salesperson:'Sales Manager',distributor:'Distributor / Customer',region:'Geography',cost:'Cost',stock:'Stock',order:'Order / Transaction',price:'Price',none:'Not mapped',text:'Text'};

function norm(s){return String(s||'').toLowerCase().trim();}

/* ---------- CSV parsing ---------- */
function parseCSV(text){
  const rows = []; let row = []; let field = ''; let inQuotes = false;
  for(let i=0;i<text.length;i++){
    const c = text[i];
    if(inQuotes){
      if(c === '"'){
        if(text[i+1] === '"'){ field += '"'; i++; } else { inQuotes = false; }
      } else field += c;
    } else {
      if(c === '"') inQuotes = true;
      else if(c === ','){ row.push(field); field=''; }
      else if(c === '\n'){ row.push(field); rows.push(row); row=[]; field=''; }
      else if(c === '\r'){ /* skip */ }
      else field += c;
    }
  }
  if(field.length || row.length){ row.push(field); rows.push(row); }
  return rows.filter(r => r.some(v => String(v).trim() !== ''));
}

function rowsFromAOA(aoa){
  if(!aoa.length) return {headers:[], rows:[]};
  const headers = aoa[0].map((h,i)=> String(h||('Column'+(i+1))).trim());
  const rows = aoa.slice(1).map(r=>{
    const o = {};
    headers.forEach((h,i)=>{ o[h] = r[i] === undefined ? '' : r[i]; });
    return o;
  });
  return {headers, rows};
}

function handleFile(file){
  const name = file.name; const ext = name.split('.').pop().toLowerCase();
  showError('');
  if(ext === 'csv'){
    const reader = new FileReader();
    reader.onload = e => {
      try{
        const aoa = parseCSV(String(e.target.result));
        const {headers, rows} = rowsFromAOA(aoa);
        onParsed(file, headers, rows, 1);
      }catch(err){ showError("This file doesn't contain usable data. (" + err.message + ")"); }
    };
    reader.onerror = () => showError("This file doesn't contain usable data.");
    reader.readAsText(file);
  } else if(ext === 'xlsx' || ext === 'xls'){
    if(typeof XLSX === 'undefined'){ showError('The spreadsheet engine failed to load. Try a .csv file instead, or reload the page.'); return; }
    const reader = new FileReader();
    reader.onload = e => {
      try{
        const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array', cellDates:true});
        const sheetName = wb.SheetNames[0];
        const aoa = XLSX.utils.sheet_to_json(wb.Sheets[sheetName], {header:1, raw:true, defval:''});
        const {headers, rows} = rowsFromAOA(aoa);
        onParsed(file, headers, rows, wb.SheetNames.length);
      }catch(err){ showError("We couldn't read this spreadsheet. Please confirm it isn't password-protected or corrupted."); }
    };
    reader.onerror = () => showError("We couldn't read this spreadsheet.");
    reader.readAsArrayBuffer(file);
  } else {
    showError('Unsupported file type. Please upload a .xlsx, .xls, or .csv file.');
  }
}

function showError(msg){
  document.getElementById('uploadError').innerHTML = msg ? `<div class="err-box">${esc(msg)}</div>` : '';
}

function onParsed(file, headers, rows, sheetCount){
  if(!headers.length || !rows.length){ showError("This file doesn't contain usable data."); return; }
  if(headers.length < 2){ showError("We couldn't identify column headers. Please check the first row of your file contains column names."); return; }
  STATE.rows = rows; STATE.headers = headers; STATE.roleOverrides = {};
  STATE.fileMeta = {name:file.name, size:file.size, sheets:sheetCount, rowCount:rows.length, colCount:headers.length};
  profileColumns();
  detectAllRoles();
  detectIndustry();
  initFilters();
  renderFileSummary();
  renderHealth();
  renderColIntel();
  renderIndustry();
  document.getElementById('toInspectBtn').disabled = false;
  markStepDone('upload');
}

/* ---------- column profiling ---------- */
function profileColumns(){
  const cols = {};
  STATE.headers.forEach(h=>{
    const vals = STATE.rows.map(r=>r[h]);
    const nonEmpty = vals.filter(v => v !== '' && v !== null && v !== undefined);
    const type = inferType(nonEmpty);
    const profile = {name:h, type, total:vals.length, nonEmpty:nonEmpty.length,
      missingPct: vals.length ? 100*(vals.length-nonEmpty.length)/vals.length : 0};
    if(type === 'numeric'){
      const nums = nonEmpty.map(toNumber).filter(n=>n!==null);
      profile.validPct = nonEmpty.length ? 100*nums.length/nonEmpty.length : 0;
      profile.min = nums.length?Math.min(...nums):null; profile.max = nums.length?Math.max(...nums):null;
      profile.sum = nums.reduce((a,b)=>a+b,0); profile.avg = nums.length?profile.sum/nums.length:0;
      profile.unique = new Set(nums).size;
    } else if(type === 'date'){
      const dates = nonEmpty.map(toDate).filter(d=>d);
      profile.validPct = nonEmpty.length ? 100*dates.length/nonEmpty.length : 0;
      profile.min = dates.length?new Date(Math.min(...dates)):null; profile.max = dates.length?new Date(Math.max(...dates)):null;
      profile.unique = new Set(dates.map(d=>d.getTime())).size;
    } else {
      const uniqSet = new Set(nonEmpty.map(v=>norm(v)));
      profile.unique = uniqSet.size;
      profile.uniqueValues = Array.from(new Set(nonEmpty.map(v=>String(v).trim()))).slice(0,500);
      profile.isCategory = profile.unique <= Math.max(40, nonEmpty.length*0.5) && profile.unique < 400;
      profile.type = profile.isCategory ? 'category' : 'text';
      // casing/trim consistency
      const canon = {};
      nonEmpty.forEach(v=>{ const k = norm(v); canon[k] = canon[k]||{}; canon[k][String(v).trim()]=(canon[k][String(v).trim()]||0)+1; });
      let inconsistent = 0, totalVariants=0;
      Object.values(canon).forEach(variants=>{ const keys=Object.keys(variants); totalVariants += keys.length; if(keys.length>1) inconsistent += keys.length-1; });
      profile.consistencyPct = nonEmpty.length ? 100 - (100*inconsistent/Math.max(1,nonEmpty.length)) : 100;
    }
    profile.sampleValues = nonEmpty.slice(0,4).map(v=>String(v));
    cols[h] = profile;
  });
  STATE.columns = cols;
}

function inferType(vals){
  if(!vals.length) return 'text';
  const sample = vals.slice(0, Math.min(200, vals.length));
  let dateHits=0, numHits=0;
  sample.forEach(v=>{
    if(v instanceof Date && !isNaN(v)) dateHits++;
    else if(toDate(v)) dateHits++;
    if(toNumber(v)!==null) numHits++;
  });
  if(dateHits/sample.length > 0.7) return 'date';
  if(numHits/sample.length > 0.7) return 'numeric';
  return 'category'; // refined later to category/text
}
function toNumber(v){
  if(v instanceof Date) return null;
  if(typeof v === 'number') return isFinite(v)?v:null;
  if(v===''||v===null||v===undefined) return null;
  const s = String(v).replace(/[₹$,%\s]/g,'').replace(/^\((.*)\)$/,'-$1');
  if(s==='' || isNaN(Number(s))) return null;
  return Number(s);
}
function toDate(v){
  if(v instanceof Date && !isNaN(v)) return v;
  if(typeof v === 'number') return null;
  if(!v) return null;
  const s = String(v).trim();
  if(/^\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}$/.test(s)){
    const parts = s.split(/[\/\-]/).map(Number);
    let [a,b,c] = parts;
    if(c<100) c += 2000;
    const d = new Date(c, (a>12?a:b)-1 >=0 ? (a>12? b-1 : a-1) : 0, a>12?b:a);
    // prefer dd-mm-yyyy for ambiguous
    const dd = parts[0], mm = parts[1], yyyy = c;
    const d2 = new Date(yyyy, mm-1, dd);
    if(!isNaN(d2) && mm<=12 && dd<=31) return d2;
  }
  const d = new Date(s);
  if(!isNaN(d) && s.length>=6 && /\d/.test(s)) return d;
  return null;
}

/* ---------- semantic role detection ---------- */
function detectAllRoles(){
  STATE.headers.forEach(h=>{
    const col = STATE.columns[h];
    const hl = norm(h);
    let best = {role:'none', confidence:'low'};
    for(const role in ROLE_SYNONYMS){
      for(const syn of ROLE_SYNONYMS[role]){
        if(hl === syn){ best = {role, confidence:'high'}; }
      }
    }
    if(best.role === 'none'){
      for(const role in ROLE_SYNONYMS){
        for(const syn of ROLE_SYNONYMS[role]){
          if(hl.includes(syn)){ best = {role, confidence:'medium'}; }
        }
      }
    }
    if(best.role === 'none'){
      if(col.type === 'date') best = {role:'date', confidence:'low'};
      else if(col.type === 'numeric') best = {role:'sales', confidence:'low'};
      else if(col.type === 'category') best = {role:'region', confidence:'low'};
    }
    col.role = best.role; col.roleConfidence = best.confidence;
  });
}
function effectiveRole(h){ return STATE.roleOverrides[h] || STATE.columns[h].role; }

/* ---------- industry detection ---------- */
const INDUSTRY_DEFS = {
  fmcg:{label:'FMCG', icon:'🧴', weights:{product:2,salesperson:2,distributor:2,target:2,sales:1,region:1}, max:10},
  retail:{label:'Retail', icon:'🛍️', weights:{product:2,region:2,sales:1,order:1}, max:6},
  ecommerce:{label:'E-commerce', icon:'🛒', weights:{order:3,distributor:1,sales:1,product:1}, max:6},
  automotive:{label:'Automotive', icon:'🚗', weights:{product:2,distributor:2,sales:1,region:1}, max:6},
  manufacturing:{label:'Manufacturing', icon:'🏭', weights:{stock:3,cost:2,quantity:1}, max:6},
  distribution:{label:'Distribution / Logistics', icon:'🚚', weights:{distributor:2,stock:2,region:1,order:1}, max:6},
  general:{label:'General business data', icon:'📈', weights:{sales:1,quantity:1,region:1}, max:3}
};
function detectIndustry(){
  const rolesPresent = {};
  STATE.headers.forEach(h=>{ const r = effectiveRole(h); rolesPresent[r] = (rolesPresent[r]||0)+1; });
  let scores = {};
  for(const key in INDUSTRY_DEFS){
    const def = INDUSTRY_DEFS[key]; let s=0;
    for(const role in def.weights){ if(rolesPresent[role]) s += def.weights[role]; }
    scores[key] = Math.min(100, Math.round(100*s/def.max));
  }
  let best = Object.keys(scores).reduce((a,b)=> scores[a]>=scores[b]?a:b);
  if(scores[best] < 35) best = 'general';
  const matched = Object.keys(INDUSTRY_DEFS[best].weights).filter(r=>rolesPresent[r]);
  const matchedCols = matched.map(role => STATE.headers.filter(h=>effectiveRole(h)===role)[0]).filter(Boolean);
  STATE.industry = {key:best, confidence:scores[best], matchedRoles:matched, matchedCols};
}
function changeIndustry(key){
  STATE.industry = {...INDUSTRY_DEFS[key] ? {key, confidence:100, matchedRoles:Object.keys(INDUSTRY_DEFS[key].weights), matchedCols:[]} : STATE.industry};
  renderIndustry();
}

/* ---------- filters ---------- */
function initFilters(){
  STATE.filters = {};
  const dateCol = primaryCol('date');
  if(dateCol){
    const prof = STATE.columns[dateCol];
    if(prof.min && prof.max){ STATE.filters.dateCol = dateCol; STATE.filters.start = prof.min; STATE.filters.end = prof.max; }
  }
  STATE.filters.cats = {};
}
function primaryCol(role, exclude){
  const cands = STATE.headers.filter(h => effectiveRole(h)===role && h!==exclude);
  if(!cands.length) return null;
  cands.sort((a,b)=> STATE.columns[b].nonEmpty - STATE.columns[a].nonEmpty);
  return cands[0];
}
function categoryCols(){
  return STATE.headers.filter(h => STATE.columns[h].type === 'category' && ['region','product','salesperson','distributor'].includes(effectiveRole(h)));
}
function getFilteredRows(){
  let rows = STATE.rows;
  const f = STATE.filters;
  if(f.dateCol && (f.start || f.end)){
    rows = rows.filter(r=>{
      const d = toDate(r[f.dateCol]); if(!d) return false;
      if(f.start && d < f.start) return false;
      if(f.end && d > f.end) return false;
      return true;
    });
  }
  if(f.cats){
    for(const col in f.cats){
      const v = f.cats[col];
      if(v && v !== '__all__') rows = rows.filter(r => String(r[col]).trim() === v);
    }
  }
  return rows;
}

/* ---------- health score ---------- */
function computeHealth(){
  const totalCells = STATE.rows.length * STATE.headers.length;
  let missingCells = 0;
  STATE.headers.forEach(h=>{ missingCells += Math.round(STATE.columns[h].missingPct/100 * STATE.rows.length); });
  const missingPct = totalCells ? 100*missingCells/totalCells : 0;

  const seen = new Set(); let dup = 0;
  STATE.rows.forEach(r=>{ const key = STATE.headers.map(h=>r[h]).join('|'); if(seen.has(key)) dup++; else seen.add(key); });
  const dupPct = STATE.rows.length ? 100*dup/STATE.rows.length : 0;

  const dateCols = STATE.headers.filter(h=>STATE.columns[h].type==='date');
  const dateCons = dateCols.length ? dateCols.reduce((a,h)=>a+STATE.columns[h].validPct,0)/dateCols.length : 100;

  const numCols = STATE.headers.filter(h=>STATE.columns[h].type==='numeric');
  const numCons = numCols.length ? numCols.reduce((a,h)=>a+STATE.columns[h].validPct,0)/numCols.length : 100;

  const catCols = STATE.headers.filter(h=>STATE.columns[h].type==='category');
  const catCons = catCols.length ? catCols.reduce((a,h)=>a+(STATE.columns[h].consistencyPct||100),0)/catCols.length : 100;

  const score = Math.round((100-missingPct)*0.25 + (100-dupPct)*0.2 + dateCons*0.2 + numCons*0.2 + catCons*0.15);
  return {score:Math.max(0,Math.min(100,score)), missingPct, dupPct, dateCons, numCons, catCons};
}

/* ================= RENDERERS ================= */
function esc(s){ return String(s).replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }
function fmtNum(n){ if(n===null||n===undefined||isNaN(n)) return '—'; const abs=Math.abs(n);
  if(abs>=10000000) return (n/10000000).toFixed(2)+'Cr';
  if(abs>=100000) return (n/100000).toFixed(2)+'L';
  if(abs>=1000) return (n/1000).toFixed(1)+'K';
  return Math.round(n*100)/100 + '';
}
function fmtFull(n){ if(n===null||n===undefined||isNaN(n)) return '—'; return Math.round(n).toLocaleString('en-IN'); }

