/* ---------- navigation ---------- */
const doneSteps = new Set();
function markStepDone(s){ doneSteps.add(s); renderStepsRail(); }
function renderStepsRail(){
  document.getElementById('stepsRail').innerHTML = STEPS.map((s,i)=>`
    <div class="step-pill ${s===currentStep?'active':''} ${doneSteps.has(s)?'done':''}" onclick="AD.goStep('${s}')">
      <div class="d">${doneSteps.has(s)&&s!==currentStep?'✓':i+1}</div>${STEP_LABELS[s]}
    </div>`).join('');
  document.getElementById('sideNav').innerHTML = STEPS.map(s=>`<a href="#" class="${s===currentStep?'active':''}" onclick="event.preventDefault(); AD.goStep('${s}')">${STEP_LABELS[s]}</a>`).join('');
}
function goStep(step){
  if(step !== 'upload' && !STATE.rows.length){ return; }
  currentStep = step;
  document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('on', p.dataset.panel===step));
  renderStepsRail();
  if(step==='dashboard'){ markStepDone('inspect'); markStepDone('industry'); renderDashboard(); }
  if(step==='ask'){ markStepDone('dashboard'); renderAskSuggestions(); }
  if(step==='explore'){ markStepDone('ask'); explorerRender(); renderProfile(); }
  if(step==='export'){ markStepDone('explore'); }
  if(step==='inspect'){ markStepDone('upload'); }
  window.scrollTo({top:0, behavior:'smooth'});
}

